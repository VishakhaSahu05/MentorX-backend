# ---------------------------------------------------------------
# MentorX backend configuration
# Copy to .env and fill in real values. Never commit .env.
# ---------------------------------------------------------------

# MongoDB connection string
DB_CONNECTION_SECRET=

# Secret used to sign auth JWTs
JWT_SECRET=

# ---- AWS S3 (media + call recordings) ----
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=ap-south-1
AWS_BUCKET_NAME=

# ---- Agora RTC (video/voice calls) ----
AGORA_APP_ID=
AGORA_APP_CERTIFICATE=

# ---- Agora Cloud Recording (call recording) ----
# These are the RESTful API "Customer ID" and "Customer Secret" from the Agora
# console (Developer Toolkit -> RESTful API). They are NOT the App ID /
# App Certificate above. Cloud Recording must also be enabled for the project.
AGORA_CUSTOMER_ID=
AGORA_CUSTOMER_SECRET=

# ---- Email (recording links) ----
# SMTP is used to send the secure recording link. For Gmail, create an
# App Password (requires 2FA) and use it as SMTP_PASS.
# Recording still works without these; the email step is skipped and the
# failure is recorded on the recording document.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=MentorX <no-reply@mentorx.app>

# ---- AI chat summary ----
GROQ_API_KEY=
